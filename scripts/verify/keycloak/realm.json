{
  "realm": "clanker",
  "displayName": "S.R.C.",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "clanker",
      "name": "S.R.C. core",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CLANKER_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "redirectUris": ["${CLANKER_PUBLIC_URL}/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "${CLANKER_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "First",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "${REALM_ADMIN_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "approver",
      "email": "${REALM_APPROVER_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Second",
      "lastName": "Approver",
      "credentials": [
        { "type": "password", "value": "${REALM_APPROVER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "outsider",
      "email": "${REALM_OUTSIDER_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "No",
      "lastName": "Role",
      "credentials": [
        { "type": "password", "value": "${REALM_OUTSIDER_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
