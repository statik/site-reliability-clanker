{
  "schema": 2,
  "name": "nginx",
  "title": "Nginx",
  "version": "0.1.0",
  "description": "The smallest pack: one web server from a published image, pinned by digest in a record for each release. Other packs start from it.",
  "layer": "50-app",
  "version_variable": "nginx_version",
  "url_output": "nginx_url",
  "releases": {
    "repository": "nginx",
    "directory": "releases",
    "first": "1.30.5"
  },
  "deploy": {
    "kind": "helm",
    "chart": "chart",
    "values": "values",
    "extras": "extras",
    "settings": [
      {"variable": "nginx_replicas", "type": "number", "min": 1, "max": 3, "default": 1,
       "value": "replicaCount"},
      {"variable": "nginx_server_tokens", "type": "bool", "default": false,
       "value": "serverTokens"}
    ],
    "secrets": ["admin-password"],
    "route": {"service": "nginx", "port": 8080, "timeout_seconds": 30},
    "timeout_seconds": 180
  },
  "runbooks": "runbooks",
  "components": [
    {"name": "server", "runtime": "kubernetes", "workload": "nginx", "required": true}
  ],
  "incident": {"runbook": "restart-component", "component": "server"},
  "diagnostics": [
    {"read": "logs", "component": "server", "lines": 30},
    {"read": "events"}
  ],
  "checks": [
    {"name": "page", "kind": "http", "path": "/index.html", "primary": true}
  ],
  "app_version": {"source": "image", "component": "server"},
  "topology": {
    "edges": [["lb", "server"]]
  }
}
