# Copy this file to terraform.tfvars in this directory and replace each value. Git ignores
# *.tfvars here: the values describe one AWS account and must not go into the repository.
#
# `clanker install --cloud aws` writes ~/.clanker/aws/<env_name>/home.tfvars in this form,
# and reads the values of that file as its defaults. The realm of Keycloak is not in this
# file, because a tfvars file cannot read a file. The installer gives it; by hand:
#   export TF_VAR_keycloak_realm="$(cat <checkout>/internal/setup/stack/keycloak-realm.json)"

env_name = "prod"
region   = "us-west-2"

# The existing VPC, its private subnets behind a NAT gateway (two zones or more), and the
# security group of its Tailscale subnet router.
vpc_id                   = "vpc-0123456789abcdef0"
private_subnet_ids       = ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]
router_security_group_id = "sg-0123456789abcdef0"

# A public Route 53 zone of the same account, for example the zone of example.com. The stack
# adds src-<env_name>.example.com and src-<env_name>-idp.example.com.
zone_id = "Z0EXAMPLE"

# The tags that the organization requires, for example on ec2:RunInstances. Use {} for none.
required_tags = {
  "example:project" = "example"
  "example:owner"   = "owner@example.com"
}

# Optional: the OpenRouter API key of the core. Without it, and without bedrock_models, the
# core uses recorded answers.
# model_api_key = "sk-or-..."

# Optional, instead of model_api_key: Amazon Bedrock in this account, an inference profile
# for each role. The role of the core may invoke these profiles and their models.
# bedrock_models = {
#   triage       = "us.anthropic.claude-haiku-5-5"
#   explainer    = "us.anthropic.claude-haiku-5-5"
#   author       = "us.anthropic.claude-sonnet-5-5"
#   investigator = "us.anthropic.claude-sonnet-5-5"
#   reviewer     = "us.anthropic.claude-sonnet-5-5"
# }

# Phase 2. Leave both unset for phase 1. The installer gives them. See README.md.
# runner_image_digest = "sha256:<64 hexadecimal digits>"
# core_image_id       = "ami-0123456789abcdef0"
