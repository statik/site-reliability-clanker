{
  "schema": 2,
  "name": "harbor",
  "title": "Harbor",
  "version": "0.1.0",
  "description": "A second application, for the tests: a small web application with an API, a worker, a database and shared files.",
  "layer": "50-app",
  "version_variable": "harbor_release",
  "url_output": "harbor_url",
  "releases": {
    "repository": "harbor",
    "directory": "notes",
    "first": "3.4.0"
  },
  "deploy": {"kind": "helm", "chart": "chart", "mount": "apps/harbor", "build": "build.sh"},
  "runbooks": "jobs",
  "components": [
    {"name": "api", "runtime": "kubernetes", "workload": "harbor-gateway", "required": true},
    {"name": "web", "runtime": "kubernetes", "workload": "harbor-ui", "required": true},
    {"name": "worker", "runtime": "kubernetes", "workload": "harbor-jobs", "required": true}
  ],
  "incident": {"runbook": "restart-deployment", "component": "api"},
  "diagnostics": [
    {"read": "logs", "component": "api", "lines": 30},
    {"read": "events"}
  ],
  "checks": [
    {"name": "ready", "kind": "http", "path": "/api/healthz"},
    {"name": "berth", "kind": "http", "path": "/v2/berths", "primary": true}
  ],
  "app_version": {"source": "http-json", "path": "/api/version"},
  "topology": {
    "extra": ["loadgen"],
    "edges": [
      ["lb", "web"], ["web", "api"], ["loadgen", "web"],
      ["api", "postgres"], ["worker", "postgres"],
      ["api", "sharedfs"], ["worker", "sharedfs"],
      ["api", "secrets"], ["worker", "secrets"]
    ]
  }
}
