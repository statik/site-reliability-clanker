{
  "schema": 2,
  "name": "paperboat",
  "title": "Paperboat",
  "version": "0.1.0",
  "description": "The example application of S.R.C.: a small web application with an API, a worker, a database and shared files.",
  "layer": "50-app",
  "version_variable": "paperboat_version",
  "url_output": "app_url",
  "releases": {
    "repository": "paperboat",
    "directory": "releases",
    "first": "1.0.0"
  },
  "deploy": {"kind": "helm", "chart": "chart", "mount": "apps/paperboat", "build": "build.sh"},
  "runbooks": "runbooks",
  "evals": "evals",
  "namespace": "paperboat",
  "data_namespace": "paperboat-data",
  "components": [
    {"name": "api", "runtime": "kubernetes", "workload": "paperboat-api", "required": true},
    {"name": "web", "runtime": "kubernetes", "workload": "paperboat-web", "required": true},
    {"name": "worker", "runtime": "kubernetes", "workload": "paperboat-worker", "required": true}
  ],
  "incident": {"runbook": "restart-deployment", "component": "api"},
  "diagnostics": [
    {"read": "logs", "component": "api", "lines": 30},
    {"read": "events"}
  ],
  "checks": [
    {"name": "ready", "kind": "http", "path": "/api/healthz"},
    {"name": "inventory", "kind": "http", "path": "/api/inventory", "primary": true}
  ],
  "app_version": {"source": "http-json", "path": "/api/version"},
  "topology": {
    "extra": ["loadgen"],
    "edges": [
      ["lb", "web"], ["web", "api"], ["loadgen", "web"],
      ["api", "postgres"], ["worker", "postgres"],
      ["api", "sharedfs"], ["worker", "sharedfs"],
      ["api", "secrets"], ["worker", "secrets"]
    ]
  }
}
