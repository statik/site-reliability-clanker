{
  "schema": 1,
  "name": "paperboat",
  "title": "Paperboat",
  "version": "0.1.0",
  "description": "The example application of S.R.C.: a small web application with an API, a worker, a database and shared files.",
  "layer": "50-app",
  "version_variable": "paperboat_version",
  "url_output": "app_url",
  "releases": {
    "repository": "paperboat",
    "directory": "releases",
    "first": "1.0.0"
  },
  "chart": "chart",
  "mount": "apps/paperboat",
  "build": "build.sh",
  "runbooks": "runbooks",
  "evals": "evals",
  "namespace": "paperboat",
  "data_namespace": "paperboat-data",
  "deployments": ["paperboat-api", "paperboat-web", "paperboat-worker"],
  "incident_deployment": "paperboat-api",
  "debug_commands": [
    ["get", "pods", "-o", "wide"],
    ["get", "deployments"],
    ["logs", "deployment/paperboat-api", "--tail=30"],
    ["get", "events", "--sort-by=.lastTimestamp"]
  ],
  "health": {
    "ready_path": "/api/healthz",
    "version_path": "/api/version",
    "probe_path": "/api/inventory",
    "probe_name": "inventory"
  },
  "topology": {
    "services": ["web", "api", "worker", "loadgen"],
    "edges": [
      ["lb", "web"], ["web", "api"], ["loadgen", "web"],
      ["api", "postgres"], ["worker", "postgres"],
      ["api", "sharedfs"], ["worker", "sharedfs"],
      ["api", "secrets"], ["worker", "secrets"]
    ]
  }
}
