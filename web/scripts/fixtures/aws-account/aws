#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# A stand-in for the AWS command line. It answers the read calls of the setup wizard as
# one account with one network that a Tailscale subnet router serves. It calls nothing.
#
# Without SRC_FIXTURE_STATE it fails for every other call, so a walk of the survey cannot
# change an account. With SRC_FIXTURE_STATE (a directory) it also answers the calls of the
# installer and of the removal, and keeps what they made in that directory, together with
# the stand-ins tofu, docker, ops and make of this directory.
#
# Usage: put the directory of this file first in PATH, then start `clanker setup`.
# With SRC_FIXTURE_LOG set, it appends each call to that file. SRC_FIXTURE_FAIL makes the
# first call that starts with its text fail once, for example "aws ecr get-login-password".
set -euo pipefail

if [ -n "${SRC_FIXTURE_LOG:-}" ]; then
  echo "$*" >>"${SRC_FIXTURE_LOG}"
fi
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state="${SRC_FIXTURE_STATE:-}"
if [ -n "${state}" ]; then
  # shellcheck source=fixture-lib.sh
  . "${here}/fixture-lib.sh"
  fail_once "aws $*"
fi

call="${1:-} ${2:-}"
# A query with length() counts what runs in a region. Only us-west-2 holds something.
counts=false
case "$*" in
*"length(Reservations"* | *"length(Vpcs"*)
  case "$*" in
  *"--region us-west-2"*) counts=true ;;
  *)
    echo 0
    exit 0
    ;;
  esac
  ;;
esac

# arg prints the value after an option.
arg() {
  local name="$1"
  shift
  while [ "$#" -gt 1 ]; do
    if [ "$1" = "${name}" ]; then
      echo "$2"
      return
    fi
    shift
  done
}

refuse() {
  echo "$1" >&2
  exit 254
}

reads() {
  case "${call}" in
  "configure list-profiles")
    echo "fixture-operator"
    ;;
  "sts get-caller-identity")
    echo '{"Account":"111122223333","Arn":"arn:aws:sts::111122223333:assumed-role/Operator/fixture"}'
    ;;
  "ec2 describe-regions")
    echo '["us-west-2","us-east-1"]'
    ;;
  "ec2 describe-instances")
    if "${counts}"; then echo 2; else echo '["vpc-0f1c7e01","vpc-0f1c7e01"]'; fi
    ;;
  "ec2 describe-vpcs")
    if "${counts}"; then
      echo 1
    else
      echo '[{"id":"vpc-0f1c7e01","cidr":"10.2.0.0/16","default":false,
        "tags":[{"Key":"Name","Value":"apps"}]}]'
    fi
    ;;
  "ec2 describe-route-tables")
    echo '[{"vpc":"vpc-0f1c7e01","main":true,"subnets":[null],"nat":null,"gateway":"igw-1"},
      {"vpc":"vpc-0f1c7e01","main":false,"subnets":["subnet-0a","subnet-0b"],"nat":"nat-1","gateway":null}]'
    ;;
  "ecs list-clusters")
    echo '["arn:aws:ecs:us-west-2:111122223333:cluster/routers"]'
    ;;
  "ecs list-services")
    echo '["arn:router"]'
    ;;
  "ecs describe-services")
    echo '[{"name":"router","task":"task-router","running":1,"subnets":["subnet-0a"],"groups":["sg-0f1c7e02"]}]'
    ;;
  "ecs describe-task-definition")
    echo '[{"image":"tailscale/tailscale:stable","routes":"10.2.0.0/16"}]'
    ;;
  "iam get-role")
    echo '"arn:aws:iam::111122223333:role/Operator"'
    ;;
  "bedrock list-inference-profiles")
    echo '[{"id":"global.anthropic.claude-sonnet-5-5","name":"Global Anthropic Claude Sonnet 5.5","status":"ACTIVE"},
      {"id":"us.anthropic.claude-haiku-5-5","name":"US Anthropic Claude Haiku 5.5","status":"ACTIVE"},
      {"id":"us.anthropic.claude-sonnet-5-5","name":"US Anthropic Claude Sonnet 5.5","status":"ACTIVE"},
      {"id":"us.moonshotai.kimi-k3.1","name":"US Moonshot AI Kimi K3.1","status":"ACTIVE"}]'
    ;;
  "bedrock get-inference-profile")
    case "$(arg --inference-profile-identifier "$@")" in
    global.anthropic.claude-sonnet-5-5 | us.anthropic.claude-haiku-5-5 | \
      us.anthropic.claude-sonnet-5-5 | us.moonshotai.kimi-k3.1)
      echo '"ACTIVE"'
      ;;
    *)
      refuse "An error occurred (ResourceNotFoundException) when calling the GetInferenceProfile operation: The inference profile was not found."
      ;;
    esac
    ;;
  "bedrock-runtime converse")
    echo '{"stopReason":"end_turn","usage":{"inputTokens":12,"outputTokens":3,"totalTokens":15},
      "output":{"message":{"role":"assistant","content":[{"text":"ready"}]}}}'
    ;;
  "iam simulate-principal-policy")
    echo '[{"action":"iam:CreateRole","decision":"allowed"},{"action":"ec2:RunInstances","decision":"allowed"}]'
    ;;
  "ec2 describe-subnets")
    if [ -n "$(arg --subnet-ids "$@")" ]; then
      echo '[{"id":"subnet-0a","vpc":"vpc-0f1c7e01","zone":"us-west-2a"},
        {"id":"subnet-0b","vpc":"vpc-0f1c7e01","zone":"us-west-2b"}]'
    else
      echo '[{"id":"subnet-0a","vpc":"vpc-0f1c7e01","cidr":"10.2.0.0/24","zone":"us-west-2a","tags":null},
        {"id":"subnet-0b","vpc":"vpc-0f1c7e01","cidr":"10.2.1.0/24","zone":"us-west-2b","tags":null},
        {"id":"subnet-0c","vpc":"vpc-0f1c7e01","cidr":"10.2.2.0/24","zone":"us-west-2a","tags":null}]'
    fi
    ;;
  *)
    return 1
    ;;
  esac
}

if reads "$@"; then
  exit 0
fi
if [ -z "${state}" ]; then
  echo "the fixture has no answer for: aws $*" >&2
  exit 1
fi
# shellcheck source=fixture-aws-install.sh
. "${here}/fixture-aws-install.sh"
